node_modules/
dist/
tests/output/
.env
# Local env files, such as .env.local and .env.production.local (.env.example is kept).
*.local
npm-debug.log*
*.log

# Claude Code: per-machine settings and the worktrees it makes for parallel sessions.
.claude/settings.local.json
.claude/worktrees/

# Exported sessions are people's results: keep them out of git.
data/

.DS_Store

# Terraform: local state, plugins and variable files (the .example ones are kept).
infra/**/.terraform/
infra/**/*.tfstate*
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/**/override.tf
infra/**/*_override.tf

# Impeccable design tool: per-machine install (skills, agents, hooks) and its local state.
.impeccable/
.claude/skills/impeccable/
.claude/agents/impeccable-*.md
.github/skills/impeccable/
.github/agents/impeccable-*.agent.md
.github/hooks/impeccable.json

# design-sync (claude.ai/design import): staged converter scripts, build output,
# machine-local state and the regenerated CSS entry. The durable sync inputs under
# .design-sync/ (config.json, NOTES.md, conventions.md, ds-entry.tsx, previews/) ARE committed.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/ds-styles.css
