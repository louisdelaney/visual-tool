# The backend's base URL. Contributed sessions are POSTed to $VITE_API_URL/sessions, and the
# group comparison is read from $VITE_API_URL/groups. Leave empty until the backend exists:
# the Contribute step still runs, but nothing is sent and no comparison is shown.
# In `npm run dev` with this empty, the comparison shows clearly labelled sample data.
VITE_API_URL=
