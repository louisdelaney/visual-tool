# The backend's base URL. Contributed sessions are POSTed to $VITE_API_URL/sessions, and the
# group comparison is read from $VITE_API_URL/groups. Leave empty until the backend exists:
# the Contribute step still runs, but nothing is sent and no comparison is shown.
# In `npm run dev` with this empty, the comparison shows clearly labelled sample data.
#
# To try the site against a local backend, start it with `cd backend && npm run dev` and
# use the line below in .env.local, then run `npm run dev` at the top level (not
# `vite preview`: the build's Content Security Policy allows only the URL set at build time).
# VITE_API_URL=http://localhost:8080
VITE_API_URL=

# An SSH alias for a build server. scripts/remote.sh and the check:* and backend:* npm scripts
# use it to run commands there instead of here. Optional: leave it unset to run everything locally.
# REMOTE_HOST=debian
